# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# logo PNG pour la console Google Cloud (généré depuis public/paw.svg, pas versionné)
/takemehome-logo-512.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — client généré (régénérer avec `npx prisma generate`)
/src/generated/prisma

# trace locale des animaux publiés sur les réseaux (npm run post:candidats)
/social-export/publicate.json

# mode à blanc et aperçu de la confirmation des annonces (npm run confirmari) :
# noms et adresses des publiants, jamais versionnés
/confirmari-export/

# captures d'écran pour les réseaux et crédits des photos (npm run seed:captures,
# npm run captures) : régénérables, jamais versionnées
/social-export/captures/
